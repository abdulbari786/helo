# ── Public (bundled into the site; never put secrets here) ────────────────────
VITE_SITE_URL=https://directrixtechnologies.com
# Real Cal.com or Calendly link. Leave empty to show the enquiry form + phone/WhatsApp/email instead.
VITE_BOOKING_URL=
# none | plausible | ga4
VITE_ANALYTICS_PROVIDER=none
VITE_PLAUSIBLE_DOMAIN=
VITE_GA4_ID=

# ── Server only (Vercel → Project → Settings → Environment Variables) ─────────
RESEND_API_KEY=
# Inbox that receives enquiries (official company email)
CONTACT_TO_EMAIL=directrixtechnologies@gmail.com
# Sender must be on a domain verified in Resend. Gmail addresses cannot be used as the sender.
# Until a domain is verified you can use Resend's test sender: onboarding@resend.dev
CONTACT_FROM_EMAIL=Directrix Website <onboarding@resend.dev>
